# ---- InclusiVenue API — copy to .env and adapt. Never commit .env ----
NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://localhost:27017/inclusivenue

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required (>= 32 chars) when NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=2h

# Web origin(s) allowed by CORS (comma separated) and used in e-mail links
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# true when served over HTTPS (production)
COOKIE_SECURE=false

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# ---- E-mail ----
# log  = development: e-mails are stored in the outbox (GET /api/dev/outbox) and printed; NOTHING is sent.
# smtp = real sending through your provider (Brevo, Mailjet, SendGrid SMTP, Gmail app password, Mailtrap for tests...)
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InclusiVenue <no-reply@inclusivenue.tn>"

# ---- Security / jobs ----
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
REMINDER_INTERVAL_MINUTES=15
# Insert demo data on first start when the database is empty
SEED_ON_START=true
