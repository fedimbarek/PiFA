{
  "ci": {
    "collect": {
      "url": ["http://localhost:8080/", "http://localhost:8080/evenements", "http://localhost:8080/connexion", "http://localhost:8080/accessibilite"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "locale": "fr" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "../deliverables/performance/lighthouse" }
  }
}
