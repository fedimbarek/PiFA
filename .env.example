# Root .env read by docker compose. Copy to .env — never commit .env.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
COOKIE_SECURE=false
# log = dev outbox (nothing sent) | smtp = real provider
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InclusiVenue <no-reply@inclusivenue.tn>"
SEED_ON_START=true
